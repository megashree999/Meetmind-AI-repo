LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=MeetMind-AI
OPENAI_API_KEY=your_openai_api_key_here
EMAIL_NOTIFICATIONS_ENABLED=false
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
JIRA_BASE_URL=https://yourname.atlassian.net
JIRA_EMAIL=your_jira_email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
GITHUB_TOKEN=your_github_pat_here
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repo_name

# ── Google Calendar Integration ──────────────────────────────────────────────
# Set to true after running: python authorize_calendar.py
CALENDAR_NOTIFICATIONS_ENABLED=false
# Google Calendar ID to add events to (use "primary" for the default calendar)
GOOGLE_CALENDAR_ID=primary
# Path to the OAuth 2.0 token file for Calendar (separate from Gmail token)
GOOGLE_CALENDAR_TOKEN_FILE=token_calendar.json
# ── Webhook Server & Integrations ──────────────────────────────────────────────
# Webhook server host and port (Cloudflare Tunnel forwards to this port)
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8000

# Secret configured in Jira Cloud Webhook settings (used to verify HMAC-SHA256 signature in X-Hub-Signature)
JIRA_WEBHOOK_SECRET=your_jira_webhook_secret_here

# Secret token configured for Google Calendar push notification watch channels
CALENDAR_WEBHOOK_SECRET=your_calendar_webhook_token_here
